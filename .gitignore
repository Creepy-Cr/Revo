# Build output
dist
tmp
out-tsc
*.tsbuildinfo

# Dependencies
node_modules

# Test and coverage output
/coverage

# Logs
npm-debug.log
yarn-error.log
pnpm-debug.log

# Local environment files. Secrets are never committed.
.env
.env.*
!.env.example

# Editors
/.idea
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace

# System files
.DS_Store
Thumbs.db

# Replit workspace internals
.cache/
.local/

# Workspace scratch, not part of the product
.agents/
attached_assets/
screenshots/

# Replit workspace configuration, kept out of the public repo.
# These files stay on disk and the project keeps running; they are simply
# not published. Re-add them if you ever want a one-click Replit clone.
.replit
.replitignore
replit.md
